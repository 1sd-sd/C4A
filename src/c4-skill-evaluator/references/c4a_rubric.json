{
  "version": "1.0.0",
  "spec": "C4A 技能提交自动评审 - 机器可读评分配置。所有阈值/信号/权重均在此声明，脚本不含评审硬编码。",
  "challenge_default": "C4",

  "naming": {
    "filename_pattern": "^(?P<author>.+?)_(?P<challenge>C\\d+[A-Z]?)_(?P<part>.+)$",
    "version_pattern": "^(?P<base>.*?)[_\\-][vV](?P<ver>\\d+)$",
    "version_in_part": "[_\\-][vV](\\d+)",
    "author_blacklist": ["unknown", "unknown_author", "anon", "匿名", "未署名"]
  },

  "file_kinds": {
    "text": [".md", ".markdown", ".txt", ".json", ".jsonl", ".yaml", ".yml", ".py", ".sh", ".bash",
             ".js", ".mjs", ".ts", ".html", ".htm", ".css", ".csv", ".tsv", ".tex", ".bib",
             ".cfg", ".toml", ".ini", ".log", ".sql", ".java", ".c", ".cpp", ".go", ".rs", ".r"],
    "docx": [".docx"],
    "opaque": [".pdf", ".pptx", ".ppt", ".xlsx", ".xls", ".doc", ".mp4", ".mov", ".webm", ".mp3",
               ".wav", ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico"],
    "archive": [".skill", ".zip", ".tar", ".gz", ".tgz", ".7z", ".rar"]
  },

  "scan": {
    "skip_dir_names": [".git", ".svn", "__pycache__", ".idea", ".vscode", "node_modules", ".venv", "venv"],
    "junk_name_patterns": ["^~\\$", "^_", "^\\._", "\\.tmp$", "\\.bak$", "\\.swp$", "^\\.DS_Store$"],
    "max_content_bytes": 262144,
    "shell_placeholder_ext": [".md", ".txt", ".py", ".sh", ".json", ".yaml", ".yml"]
  },

  "required_deliverables": {
    "skill_doc": {
      "label": "Skill 说明文档",
      "weight": 0.25,
      "filename_signals": ["skill说明", "skill说明文档", "skill_doc", "skill-doc", "skill_description", "技能说明"],
      "accept_ext": [".md", ".docx", ".pdf", ".txt"],
      "content_signals": ["使用场景", "解决什么问题", "输入", "输出", "适用场景"],
      "content_min_hits": 2
    },
    "executable": {
      "label": "可执行内容",
      "weight": 0.30,
      "filename_signals": ["skill", "技能", "checker", "evaluator", "mapper", "explainer", "generator", "tool"],
      "accept_ext": [".skill", ".py", ".zip", ".sh", ".js", ".md", ".ipynb"],
      "strong_ext": [".skill", ".py", ".zip", ".sh", ".js", ".ipynb"],
      "content_signals": ["```", "def ", "class ", "import ", "workflow", "工作流"],
      "content_min_hits": 1
    },
    "demo": {
      "label": "Demo（视频/截图）",
      "weight": 0.15,
      "filename_signals": ["demo", "演示", "截图", "录屏", "screen", "screenshot", "运行结果"],
      "accept_ext": [".mp4", ".mov", ".webm", ".png", ".jpg", ".jpeg", ".gif", ".md"],
      "content_signals": [],
      "content_min_hits": 1
    },
    "teaching_doc": {
      "label": "教学说明",
      "weight": 0.15,
      "filename_signals": ["教学说明", "教学", "上手指南", "tutorial", "teaching", "quickstart", "how-to", "howto", "使用说明"],
      "accept_ext": [".md", ".docx", ".pdf", ".txt"],
      "content_signals": ["上手", "步骤", "常见坑", "安装", "注意事项", "getting started"],
      "content_min_hits": 2
    },
    "ai_log": {
      "label": "AI 日志",
      "weight": 0.15,
      "filename_signals": ["AI日志", "AI_log", "ai-log", "ai_日志", "ai使用记录", "AI使用日志"],
      "accept_ext": [".md", ".docx", ".pdf", ".txt"],
      "content_signals": ["使用的 AI", "AI 工具", "prompt", "迭代", "ChatGPT", "Claude", "DeepSeek", "Cursor", "CodeBuddy"],
      "content_min_hits": 2
    }
  },

  "match_weights": {
    "filename_signal": 3.0,
    "extension": 1.0,
    "content_signal": 0.5,
    "content_signal_cap": 2.0,
    "strong_threshold": 3.0,
    "weak_threshold": 1.5,
    "hollow_bytes": 32
  },

  "quality_profiles": {
    "c4_four_conditions": {
      "label": "C4 四条件（可复用 / 可执行 / 可验证 / IO 明确）",
      "criteria": {
        "reusable": {
          "label": "可复用",
          "label_en": "Reusable",
          "weight": 0.25,
          "intent": "别人拿过去能直接用，不依赖作者本机环境",
          "items": [
            {
              "id": "install_doc",
              "check": "有安装 / 上手步骤",
              "rule": "keyword",
              "any_of": ["安装", "安装步骤", "使用步骤", "pip install", "npm install", "install", "上手", "getting started", "解压"],
              "fix": "在技能说明或教学说明中补一段「安装 / 上手」步骤（含具体命令）。"
            },
            {
              "id": "abs_path_in_code",
              "check": "可执行文件内无硬编码绝对路径",
              "rule": "forbidden_in_code",
              "critical": true,
              "pattern": "(?:[A-Za-z]:[\\\\/]|/Users/|/home/[a-z]|/mnt/|\\\\\\\\[A-Za-z0-9_.-]{2,}\\\\[A-Za-z0-9_.$-]{2,})",
              "fix": "把脚本里的绝对路径改为命令行参数 / 环境变量 / 相对路径，并给默认值。"
            },
            {
              "id": "abs_path_in_doc",
              "check": "文档内绝对路径仅作为示例且数量有限",
              "rule": "forbidden_in_doc",
              "pattern": "(?:[A-Za-z]:[\\\\/]|/Users/|/home/[a-z]|/mnt/)",
              "max_allow": 4,
              "max_allow_partial": 20,
              "fix": "文档示例路径统一用占位符（如 <你的文件夹>），减少对本机目录的暗示。"
            },
            {
              "id": "env_req",
              "check": "声明了运行环境 / 依赖",
              "rule": "keyword",
              "any_of": ["环境要求", "依赖", "requirements", "dependencies", "python 3", "python3", "node", "版本要求", "零依赖", "no third", "运行时"],
              "fix": "补一行「运行环境」：语言与版本、是否需要第三方库。"
            },
            {
              "id": "portability",
              "check": "有平台兼容 / 泛化说明",
              "rule": "keyword",
              "any_of": ["兼容", "compatible", "windows", "macos", "linux", "跨平台", "任意文件夹", "任意路径", "平台无关"],
              "fix": "说明支持哪些操作系统，以及输入是否接受任意本地文件夹路径。"
            }
          ]
        },
        "executable": {
          "label": "可执行",
          "label_en": "Executable",
          "weight": 0.25,
          "intent": "不是理论，是能跑的东西",
          "items": [
            {
              "id": "runnable_payload",
              "check": "含可运行代码 / 工作流定义",
              "rule": "executable_present",
              "any_of": ["```", "def ", "class ", "import ", "workflow", "工作流", "步骤"],
              "fix": "补一个可直接运行的脚本，或在 SKILL.md 里给出有序可执行的工作流步骤。"
            },
            {
              "id": "package_valid",
              "check": "技能包结构合法（.skill/zip 可解压且含 SKILL.md）",
              "rule": "package_valid",
              "critical": true,
              "fix": "重打 .skill 包：确认是 zip、根目录含 SKILL.md、且未多套一层目录。"
            },
            {
              "id": "python_syntax",
              "check": "Python 源码语法可解析",
              "rule": "python_syntax",
              "fix": "修掉脚本的语法错误（本项用 compile() 实测，不是关键词判断）。"
            },
            {
              "id": "frontmatter",
              "check": "SKILL.md 具备有效 YAML frontmatter（name + description）",
              "rule": "frontmatter",
              "critical": true,
              "fix": "在 SKILL.md 顶部补 `--- name: ... description: ... ---`，否则技能永远不会被触发。"
            }
          ]
        },
        "verifiable": {
          "label": "可验证",
          "label_en": "Verifiable",
          "weight": 0.25,
          "intent": "有明确的输入输出，能判断成功与否",
          "items": [
            {
              "id": "test_or_example",
              "check": "有测试用例或可复跑示例",
              "rule": "keyword_or_file",
              "any_of": ["测试", "自测", "test", "assert", "断言", "示例", "example", "run_selftest", "selftest"],
              "file_name_any": ["run_selftest", "self_test", "test_", "_test"],
              "fix": "附一个可复跑的示例或断言式自测脚本（run_selftest.py 之类）。"
            },
            {
              "id": "expected_output",
              "check": "写明了预期输出 / 结果",
              "rule": "keyword",
              "any_of": ["预期", "expected", "应输出", "输出示例", "结果如下", "得到以下", "标准答案"],
              "fix": "给出一次真实运行的预期输出（贴 stdout 或结果文件片段）。"
            },
            {
              "id": "demo_present",
              "check": "Demo 文件存在且非空",
              "rule": "deliverable_nonempty",
              "critical": true,
              "deliverable": "demo",
              "fix": "补 demo（截图或录屏），文件不能是 0 字节。"
            },
            {
              "id": "pass_fail_rule",
              "check": "有明确的通过 / 失败判据",
              "rule": "keyword",
              "any_of": ["pass", "fail", "判定", "阈值", "退出码", "exit code", "≥", ">=", "不通过", "通过标准"],
              "fix": "写下可判定的成功/失败标准（如「分数 ≥85 且无阻断项 = PASS」）。"
            }
          ]
        },
        "clear_io": {
          "label": "IO 明确",
          "label_en": "Clear I/O",
          "weight": 0.25,
          "intent": "输入什么、输出什么，一目了然",
          "items": [
            {
              "id": "io_oneliner",
              "check": "存在「输入 X，输出 Y」式一句话描述",
              "rule": "regex",
              "pattern": "(输入[^。\\n]{0,60}输出|接受[^。\\n]{0,40}返回|input[^\\n]{0,60}output|给定[^。\\n]{0,30}得到|读入[^。\\n]{0,40}生成)",
              "reject_if": [".*", "___", "____", "XXX", "输入...输出", "输入…输出"],
              "critical": true,
              "fix": "在技能说明开头补一句话：「输入 ___，输出 ___」。"
            },
            {
              "id": "input_typed",
              "check": "输入的类型 / 格式有说明",
              "rule": "keyword",
              "any_of": ["输入", "参数", "input", "argv", "stdin", "接受", "读入"],
              "fix": "说明输入是什么：文件夹路径 / 文件 / 参数名 / 格式。"
            },
            {
              "id": "output_typed",
              "check": "输出的类型 / 格式有说明",
              "rule": "keyword",
              "any_of": ["输出", "生成", "产出", "报告", "output", "返回", ".md", ".json", ".csv", "stdout"],
              "fix": "说明输出是什么：文件名、格式（.md/.json/.csv）与落在哪里。"
            },
            {
              "id": "edge_inputs",
              "check": "说明了边界输入的处理",
              "rule": "keyword",
              "any_of": ["空文件夹", "边界", "缺失", "异常", "没有文件时", "edge case", "错误处理", "非法输入"],
              "fix": "补「边界情况」一节：空文件夹、缺文件、不规范命名时分别怎么处理。"
            }
          ]
        }
      }
    },

    "platform_100": {
      "label": "平台评分维度（100 分制，含红旗降级）",
      "source": "challenge.json rubric_dimensions / rubric.json",
      "criteria": {
        "evaluatorQuality": {
          "label": "评审器质量",
          "label_en": "Evaluator Quality",
          "weight": 0.25,
          "intent": "自动评审器/评测器的质量与可靠性",
          "items": [
            { "id": "criteria_clear", "check": "评分标准清晰、公开可核对", "rule": "keyword", "any_of": ["评分标准", "评分规则", "rubric", "权重", "scoring", "判定规则"], "fix": "公开评分标准：每个维度几条检查项、每项怎么给分。" },
            { "id": "has_testcases", "check": "有测试用例 / 自测集", "rule": "keyword_or_file", "any_of": ["测试用例", "自测", "ground truth", "test case", "断言", "assert"], "file_name_any": ["selftest", "test_", "_test", "ground_truth"], "fix": "补一组带标准答案的测试用例，并用它度量你自己评审器的准确率。" },
            { "id": "error_rate", "check": "给出了误判率 / 准确率数据", "rule": "keyword", "any_of": ["误判率", "准确率", "accuracy", "false positive", "precision", "recall", "错判"], "fix": "在报告里给出准确率与误判率数字（分子分母都要写清）。" },
            { "id": "not_random", "check": "结果确定（同输入同输出）", "rule": "keyword_or_determinism", "any_of": ["确定性", "deterministic", "可复现", "同输入", "幂等", "重复运行"], "fix": "说明评审器在相同输入下输出稳定（确定性规则 / 固定温度），并提供可复跑命令。" }
          ],
          "negative_signals": ["评分随意", "无标准"]
        },
        "technicalExecution": {
          "label": "技术实现",
          "label_en": "Technical Execution",
          "weight": 0.20,
          "intent": "技术方案合理性与工程质量",
          "items": [
            { "id": "code_clean", "check": "代码可读、职责清晰", "rule": "keyword_or_file", "any_of": ["模块", "函数", "类", "docstring", "注释"], "file_name_any": [".py"], "fix": "拆分函数、补 docstring，别把所有逻辑堆在 main 里。" },
            { "id": "git_clear", "check": "有 Git 提交 / 版本痕迹", "rule": "keyword_or_file", "any_of": ["git", "commit", "提交历史", "版本"], "file_name_any": [".gitignore", ".gitattributes"], "fix": "建立 Git 仓库并写清晰的提交信息。" },
            { "id": "architecture", "check": "有架构说明 / 设计文档", "rule": "keyword", "any_of": ["架构", "architecture", "数据流", "流水线", "pipeline", "流程图", "设计文档", "方案设计"], "fix": "写一份方案设计文档，画出流水线与模块边界。" },
            { "id": "no_hardcode", "check": "无硬编码 / 无无法运行", "rule": "forbidden_in_code", "pattern": "(?:[A-Za-z]:[\\\\/]|/Users/|/home/[a-z]|/mnt/|\\\\\\\\[A-Za-z0-9_.-]{2,}\\\\[A-Za-z0-9_.$-]{2,})", "fix": "去掉脚本里的绝对路径与写死配置。" }
          ],
          "negative_signals": ["硬编码", "代码混乱", "无法运行"]
        },
        "artifactCompleteness": {
          "label": "产物完整性",
          "label_en": "Artifact Completeness",
          "weight": 0.15,
          "intent": "交付物是否齐全、可运行、可独立使用",
          "items": [
            { "id": "readme", "check": "README 齐全", "rule": "keyword_or_file", "any_of": ["readme", "说明"], "file_name_any": ["README"], "fix": "补 README.md：是什么、怎么用、产物在哪。" },
            { "id": "runnable", "check": "能独立运行", "rule": "keyword", "any_of": ["运行", "执行", "python ", "用法", "usage", "示例命令"], "fix": "给出可直接复制运行的命令。" },
            { "id": "install_usage", "check": "有安装 / 使用说明", "rule": "keyword", "any_of": ["安装", "使用说明", "install", "上手", "getting started"], "fix": "补安装与使用说明。" },
            { "id": "no_empty", "check": "无空文件 / 无空壳", "rule": "no_hollow", "fix": "删除或补全内容为空/仅占位符的文件。" }
          ],
          "negative_signals": ["文件为空", "缺少核心交付物"]
        },
        "aiUsage": {
          "label": "AI使用质量",
          "label_en": "AI Usage",
          "weight": 0.20,
          "intent": "AI 工具使用是否恰当、有效、可追溯",
          "items": [
            { "id": "iterations", "check": "记录多轮迭代", "rule": "keyword", "any_of": ["迭代", "v2", "第二轮", "修订", "iteration", "反思后改动", "返工"], "fix": "在 AI 日志里按轮次记录：每轮问什么、AI 给什么、你怎么改。" },
            { "id": "prompt_opt", "check": "有 prompt 优化痕迹", "rule": "keyword", "any_of": ["prompt", "提示词", "指令", "重写需求"], "fix": "贴出关键 prompt 的原始版本与改进版本，说明为什么改。" },
            { "id": "workflow_design", "check": "有工作流设计", "rule": "keyword", "any_of": ["工作流", "流程", "workflow", "分工", "角色", "多agent", "多 agent"], "fix": "说明你怎么把任务拆给 AI：先什么后什么、谁审谁。" },
            { "id": "ai_log_evidence", "check": "AI 日志可追溯（含原始输出）", "rule": "keyword_or_file", "any_of": ["AI日志", "对话记录", "原始输出", "粘贴", "transcript"], "file_name_any": ["AI日志", "AI_log"], "fix": "提供 AI 日志文件，直接粘贴关键对话/输出而不是转述。" }
          ],
          "negative_signals": ["一句话指令直接提交", "没有AI使用记录"]
        },
        "reflectionQuality": {
          "label": "复盘质量",
          "label_en": "Reflection Quality",
          "weight": 0.20,
          "intent": "AAR 反思是否深入、有洞察、有改进方案",
          "items": [
            { "id": "problem_analysis", "check": "有具体问题分析", "rule": "keyword", "any_of": ["问题", "根因", "失败", "踩坑", "缺陷", "不足"], "fix": "具体写出遇到的问题与根因，不要写「还需努力」。" },
            { "id": "improvement_plan", "check": "有可执行改进方案", "rule": "keyword", "any_of": ["改进", "下一步", "计划", "方案", "优化", "todo 改进"], "fix": "给出下一步的行动清单，每条可执行、可验证。" },
            { "id": "iteration_log", "check": "记录迭代过程", "rule": "keyword", "any_of": ["迭代", "版本", "v1", "v2", "过程", "轨迹"], "fix": "按时间/版本记录关键决策变化。" },
            { "id": "failure_recorded", "check": "记录了失败经验", "rule": "keyword", "any_of": ["失败", "错误", "走弯路", "不work", "不行", "被否", "教训"], "fix": "写出至少一条失败尝试及其教训——只写成功经验的复盘价值有限。" }
          ],
          "negative_signals": ["敷衍了事", "没有实际反思"]
        }
      }
    }
  },

  "scoring": {
    "item_values": { "pass": 1.0, "partial": 0.5, "fail": 0.0 },
    "rating_thresholds": { "pass": 0.8, "partial": 0.4 },
    "rating_labels": {
      "pass": { "symbol": "✅", "cn": "达标" },
      "partial": { "symbol": "⚠️", "cn": "部分达标" },
      "fail": { "symbol": "❌", "cn": "未达标" }
    },
    "completeness_bands": {
      "complete": { "min_ratio": 1.0, "symbol": "✅", "cn": "齐全（5/5）" },
      "partial": { "min_ratio": 0.6, "symbol": "⚠️", "cn": "部分缺失" },
      "insufficient": { "min_ratio": 0.0, "symbol": "❌", "cn": "严重缺失" }
    },
    "composite": {
      "formula": "completeness_ratio * w_completeness + quality_ratio * w_quality",
      "default_weights": { "completeness": 0.4, "quality": 0.6 },
      "scale": 100,
      "grade_bands": [
        { "min": 85, "grade": "A", "cn": "优秀" },
        { "min": 70, "grade": "B", "cn": "良好" },
        { "min": 55, "grade": "C", "cn": "及格" },
        { "min": 0,  "grade": "D", "cn": "需返工" }
      ]
    }
  },

  "red_flags": [
    { "id": "missing_artifacts", "cn": "核心交付物缺失", "severity": "high", "detector": "missing_deliverable_count>=2", "cap_score": 50, "hint": "补齐缺失的交付物后再提交。" },
    { "id": "hollow_file", "cn": "空壳文件（0 字节或仅占位符）", "severity": "high", "detector": "hollow_files>0", "cap_score": 60, "hint": "把 TODO/待补充 的占位文件补成真实内容。" },
    { "id": "fake_package", "cn": "伪 .skill 包（无法解压/缺 SKILL.md）", "severity": "high", "detector": "fake_packages>0", "cap_score": 55, "hint": "重新打包：zip 格式 + 根目录 SKILL.md。" },
    { "id": "secret_leak", "cn": "疑似敏感信息泄露", "severity": "critical", "detector": "secrets>0", "cap_score": 40, "hint": "删除密钥/口令，改用环境变量。" },
    { "id": "no_ai_log", "cn": "无 AI 使用记录", "severity": "high", "detector": "missing_deliverable:ai_log", "cap_score": 65, "hint": "补 AI 日志（含关键 prompt 与迭代）。" },
    { "id": "no_demo", "cn": "无 Demo", "severity": "medium", "detector": "missing_deliverable:demo", "cap_score": 75, "hint": "补一张截图或一段录屏，证明能跑。" },
    { "id": "one_shot_ai", "cn": "一句话指令直接提交、无迭代", "severity": "medium", "detector": "declared_iterations<=1", "cap_score": 80, "hint": "在 AI 日志里体现多轮迭代与 prompt 优化。" },
    { "id": "junk_files", "cn": "目录内含草稿/锁文件等垃圾", "severity": "low", "detector": "junk_files>0", "cap_score": 88, "hint": "提交前删掉 ~$*.docx、_*.json、*.tmp 等草稿。" },
    { "id": "secret_fixture_ignored", "cn": "已排除测试夹具中的假密钥", "severity": "info", "detector": "fixture_secrets>0", "cap_score": 100, "hint": "无需处理：这些是测试夹具里有意放置的假数据。" }
  ],

  "secret_patterns": [
    "(?:sk|pk|rk)-[A-Za-z0-9]{16,}",
    "(?i)api[_-]?key\\s*[=:]\\s*[\"'][A-Za-z0-9_\\-]{12,}[\"']",
    "(?i)(?:password|passwd|token|secret)\\s*[=:]\\s*[\"'][^\"'\\s]{6,}[\"']",
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "(?i)AKIA[0-9A-Z]{16}"
  ],

  "fixture_guard": {
    "note": "测试夹具不是泄露：夹具目录下的假密钥/占位符是有意为之，必须与真实泄露区分开，否则会产生系统性假阳性（本评审器 v0.9 的真实误判案例）。",
    "path_re": "(?i)(^|[/\\\\])(examples?|fixtures?|tests?|testdata|samples?|__tests__|demo[-_][A-Za-z0-9]*)([/\\\\]|::|$)",
    "context_re": "(?i)(fake|dummy|sample|example|fixture|placeholder|redacted|测试|示例|假|占位|演示)"
  },

  "hollow_patterns": [
    "^\\s*(?:TODO|FIXME|TBD|待补充|待完善|占位|placeholder)\\b?",
    "^\\s*<[^>]{0,20}待填[^>]{0,20}>\\s*$",
    "^\\s*\\.\\.\\.\\s*$",
    "^\\s*（待填）\\s*$"
  ],

  "improvement_hints": {
    "most_missing": "补齐交付物：{items}。评审前先跑一次自检，别让「以为交齐了」变成失分点。",
    "weakest_criterion": "全班最弱维度是「{label}」——{intent}。建议下一次提交前专门针对这一条自检。",
    "no_demo": "缺 demo 是最常见的失分点：截图成本最低，收益最高。",
    "generic": "提交前用本评审器自检一次：{cmd}"
  }
}
